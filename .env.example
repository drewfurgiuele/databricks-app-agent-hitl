# Copy to .env for local development: cp .env.example .env
# .env is gitignored; app.yaml supplies these values when deployed.

# Databricks auth for local runs: pick a profile from ~/.databrickscfg
# (or set DATABRICKS_HOST + DATABRICKS_TOKEN instead).
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Genie space the agent queries (Health Claims Data Room)
GENIE_SPACE_ID=01f08a5f354519db92cd69d45c5918ff

# Unity Catalog model name, called via AI Gateway (/ai-gateway/mlflow/v1/responses)
LLM_ENDPOINT=external_catalog.default.apim-gpt-6-sol
